{
  "name": "@bookingapp/backend-api",
  "version": "1.0.0",
  "description": "Express API for BookingAPP",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "nodemon --exec \"node -r dotenv/config -r ts-node/register server.ts\" --watch server.ts --watch routes --ext ts",
    "build": "tsc -p ../../tsconfig.json",
    "start": "node ../../dist/backend/api/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
}
