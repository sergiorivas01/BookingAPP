{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "bookingapp-lib",
  "projectType": "library",
  "sourceRoot": "bookingapp-lib",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist && pnpm --filter \"@bookingapp/lib\" build",
        "cwd": "bookingapp-lib"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter \"@bookingapp/lib\" test",
        "cwd": "bookingapp-lib"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter \"@bookingapp/lib\" lint",
        "cwd": "bookingapp-lib"
      }
    }
  },
  "tags": ["scope:shared", "type:lib"]
}
